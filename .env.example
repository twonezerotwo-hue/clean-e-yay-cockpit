# Clean E-yAy Cockpit (Next.js) local dev env example.
# Usage: copy this file to `.env.local`.

# API base URL. Default: http://127.0.0.1:9000
# Legacy NEXT_PUBLIC_API_BASE is still supported as a fallback.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:9000

# Public app version tag (optional, used in ops surfaces).
# NEXT_PUBLIC_APP_TAG=clean-eyay-dev
